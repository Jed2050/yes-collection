# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Node
node_modules/
.npm/

# Local env
.env
.env.local

# Runtime data (admin credentials + user uploads should not be committed)
data/admin.json
data/uploads/*
!data/uploads/.gitkeep

# Hostinger backups
*.bak
*-backup/

# Live data (admin edits) — seeded from products.json.example on first boot
data/products.json

# Uploaded product images (admin uploads) — keep folder, ignore contents
assets/img/products/*
!assets/img/products/.gitkeep
