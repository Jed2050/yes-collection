# =========================================================================
# YES COLLECTION — Hostinger configuration
# Drop this file at the document root (public_html/) alongside index.html
# =========================================================================

# ----- Default document -----
DirectoryIndex index.html

# ----- Force HTTPS (Hostinger SSL) -----
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ----- Strip www. (use root domain) -----
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ----- Clean URLs: hide .html extension -----
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Redirect /page.html to /page (visible URL stays clean)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html\ HTTP
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# ----- Custom 404 -----
ErrorDocument 404 /404.html

# ----- Browser caching -----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                      "access plus 0 seconds"
  ExpiresByType text/css                       "access plus 1 year"
  ExpiresByType application/javascript         "access plus 1 year"
  ExpiresByType image/jpeg                     "access plus 1 year"
  ExpiresByType image/png                      "access plus 1 year"
  ExpiresByType image/webp                     "access plus 1 year"
  ExpiresByType image/svg+xml                  "access plus 1 year"
  ExpiresByType font/woff2                     "access plus 1 year"
  ExpiresByType application/font-woff2         "access plus 1 year"
</IfModule>

# ----- Compression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

# ----- Security headers -----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ----- Block hidden files -----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ----- MIME -----
AddType image/webp .webp
AddType font/woff2 .woff2
